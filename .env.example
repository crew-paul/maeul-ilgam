# Server-side only. Do not put credentials in VITE_* variables.
META_API_KEY=
PORT=3001
HOST=127.0.0.1
# Local tests only: codes are shown on screen, never sent.
AUTH_MODE=development
# Create 10 clearly labeled fictional opportunities in server memory.
SEED_DEMO_DATA=1
# For real delivery, set AUTH_MODE=provider and configure one or both channels.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# For production: NODE_ENV=production, HTTPS origin, HOST=0.0.0.0 as appropriate.
APP_ORIGIN=
TRUST_PROXY=0
# Application data is always in memory. No DATABASE_URL or disk data directory.
